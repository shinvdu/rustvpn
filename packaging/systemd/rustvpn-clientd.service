[Unit]
Description=RustVPN client daemon
Documentation=https://github.com/shinvdu/rustvpn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustvpn
Group=rustvpn
RuntimeDirectory=rustvpn-client
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/rustvpn-clientd -socket /run/rustvpn-client/client.sock -socket-group rustvpn
# Backstop for a crash: the route is marked with proto 66 so it cannot be
# confused with an administrator's own blackhole route.
ExecStopPost=-/usr/sbin/ip -6 route del blackhole default proto 66 metric 50
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target