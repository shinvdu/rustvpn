# Compose defaults for a published-image deployment.
# quickstart.sh writes the real file to $RUSTVPN_DATA_DIR/.env.
RUSTVPN_PROJECT=rustvpn
RUSTVPN_IMAGE_TAG=0.2.0
RUSTVPN_SERVER_IMAGE=ghcr.io/shinvdu/rustvpn/rustvpn-server:0.2.0
RUSTVPN_ADMIN_IMAGE=ghcr.io/shinvdu/rustvpn/rustvpn-admind:0.2.0
RUSTVPN_DATA_DIR=/opt/rustvpn
RUSTVPN_LISTEN_IP=0.0.0.0
RUSTVPN_PORT=1194
RUSTVPN_ADMIN_PORT=8080
RUSTVPN_NAT=1
RUSTVPN_TUNNEL_POOL=10.88.0.0/16